        "name": "--elevation-sm",
        "$type": "shadow",
        "value": "inset 1px 1px 0 #ffffff, inset -1px -1px 0 #404040",
        "role": "card-shadow"
      },
      {
        "name": "--elevation-md",
        "$type": "shadow",
        "value": "2px 2px 0 #000000",
        "role": "card-hover"
      }
    ],
    "motion": [
      {
        "name": "--ease-standard",
        "$type": "raw",
        "value": "0.12s steps(4)",
        "role": "transition"
      },
