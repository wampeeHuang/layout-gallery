{
  "template": "brutalist-paper",
  "version": 1,
  "description": "Auto-generated from brand.json + layout.json. Review before publishing.",
  "tokens": {
    "color": [
      {
        "name": "--color-primary",
        "$type": "color",
        "value": "#b84f35",
        "role": "accent"
      },
      {
        "name": "--color-secondary",
        "$type": "color",
        "value": "#d89a57",
        "role": "accent-alt"
      },
      {
        "name": "--color-surface",
        "$type": "color",
        "value": "#f4efe7",
        "role": "surface-bg"
      },
      {
        "name": "--color-surface-container",
        "$type": "color",
        "value": "rgba(244,239,231,0.75)",
        "role": "surface-glass"
      },
      {
        "name": "--color-on-surface",
        "$type": "color",
        "value": "#1b1916",
        "role": "text-primary"
      },
      {
        "name": "--color-on-surface-variant",
        "$type": "color",
        "value": "#5f5951",
        "role": "text-secondary"
      },
      {
        "name": "--color-outline",
        "$type": "color",
        "value": "rgba(27, 25, 22, 0.18)",
        "role": "border"
      },
      {
        "name": "--color-outline-variant",
        "$type": "color",
        "value": "rgba(27, 25, 22, 0.1)",
        "role": "border-light"
      },
      {
        "name": "--color-surface-container-low",
        "$type": "color",
        "value": "rgba(255, 253, 248, 0.62)",
        "role": "surface-card"
      }
    ],
    "typography": [
      {
        "name": "--font-display",
        "$type": "fontFamily",
        "value": "Georgia, \"Times New Roman\", \"Noto Serif SC\", \"Songti SC\", serif",
        "role": "display-font"
      },
      {
        "name": "--font-body",
        "$type": "fontFamily",
        "value": "Inter, \"PingFang SC\", \"Microsoft YaHei\", \"Hiragino Sans GB\", ui-sans-serif, system-ui, sans-serif",
        "role": "body-font"
      },
      {
        "name": "--font-mono",
        "$type": "fontFamily",
        "value": "\"SF Mono\", Consolas, \"Courier New\", monospace",
        "role": "mono-font"
      },
      {
        "name": "--sz-hero",
        "$type": "dimension",
        "value": "clamp(4.25rem, 11vw, 9.6rem)",
        "role": "hero 主标题 h1"
      },
      {
        "name": "--sz-manifesto",
        "$type": "dimension",
        "value": "clamp(2.6rem, 5.5vw, 5rem)",
        "role": "宣言标题"
      },
      {
        "name": "--sz-section",
        "$type": "dimension",
        "value": "clamp(2.45rem, 5vw, 4.6rem)",
        "role": "段落标题 h2"
      },
      {
        "name": "--sz-quote",
        "$type": "dimension",
        "value": "clamp(2rem, 4.9vw, 4.7rem)",
        "role": "引用文字"
      },
      {
        "name": "--sz-record-title",
        "$type": "dimension",
        "value": "clamp(1.35rem, 2.6vw, 1.85rem)",
        "role": "记录标题 h3"
      },
      {
        "name": "--sz-card-title",
        "$type": "dimension",
        "value": "1.55rem",
        "role": "卡片/面板标题"
      },
      {
        "name": "--sz-lead",
        "$type": "dimension",
        "value": "clamp(1.08rem, 2vw, 1.38rem)",
        "role": "导语/摘要"
      },
      {
        "name": "--sz-body",
        "$type": "dimension",
        "value": "1rem",
        "role": "正文"
      },
      {
        "name": "--sz-note",
        "$type": "dimension",
        "value": "0.9rem",
        "role": "注释/附注"
      },
      {
        "name": "--sz-button",
        "$type": "dimension",
        "value": "0.83rem",
        "role": "按钮"
      },
      {
        "name": "--sz-mono-label",
        "$type": "dimension",
        "value": "0.82rem",
        "role": "等宽标签/日期"
      },
      {
        "name": "--sz-eyebrow",
        "$type": "dimension",
        "value": "0.72rem",
        "role": "眉标"
      },
      {
        "name": "--sz-caption",
        "$type": "dimension",
        "value": "0.71rem",
        "role": "报头/说明"
      },
      {
        "name": "--sz-tag",
        "$type": "dimension",
        "value": "0.66rem",
        "role": "标签/徽标"
      }
    ],
    "radius": [
      {
        "name": "--radius-base",
        "$type": "dimension",
        "value": "0px",
        "role": "radius-base"
      }
    ],
    "shadow": [
      {
        "name": "--elevation-sm",
        "$type": "shadow",
        "value": "0px 4px 15px 0px rgba(0,0,0,0.1)",
        "role": "card-shadow"
      },
      {
        "name": "--elevation-md",
        "$type": "shadow",
        "value": "4px 4px 0 #b84f35",
        "role": "card-hover"
      },
      {
        "name": "--shadow",
        "$type": "shadow",
        "value": "0px 4px 15px 0px rgba(0,0,0,0.1)",
        "role": "card-shadow"
      },
      {
        "name": "--shadow-solid",
        "$type": "shadow",
        "value": "4px 4px 0 #b84f35",
        "role": "accent-shadow"
      },
      {
        "name": "--shadow-block",
        "$type": "shadow",
        "value": "10px 10px 0 #b84f35",
        "role": "hero-shadow"
      }
    ],
    "motion": [
      {
        "name": "--ease-standard",
        "$type": "raw",
        "value": "0.18s ease",
        "role": "transition"
      },
      {
        "name": "--duration-base",
        "$type": "duration",
        "value": "150ms",
        "role": "duration"
      },
      {
        "name": "--ease-hover",
        "$type": "raw",
        "value": "0.2s ease",
        "role": "transition"
      }
    ],
    "spacing": [
      {
        "name": "--space-page-wmax",
        "$type": "dimension",
        "value": "1180px",
        "role": "page-width"
      },
      {
        "name": "--space-page-pad",
        "$type": "dimension",
        "value": "32px",
        "role": "page-pad"
      },
      {
        "name": "--space-gap",
        "$type": "dimension",
        "value": "24px",
        "role": "grid-gap"
      },
      {
        "name": "--space-gutter",
        "$type": "dimension",
        "value": "24px",
        "role": "gutter"
      },
      {
        "name": "--page-w",
        "$type": "dimension",
        "value": "1180px",
        "role": "page-width"
      }
    ]
  }
}