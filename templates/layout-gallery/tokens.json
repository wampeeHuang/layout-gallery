      {
        "name": "--space-xl",
        "$type": "dimension",
        "value": "32px",
        "role": "component-gap"
      },
      {
        "name": "--space-md",
        "$type": "dimension",
        "value": "16px",
        "role": "tight-gap"
      },
      {
        "name": "--space-xs",
        "$type": "dimension",
        "value": "8px",
        "role": "micro-gap"
      },
      {
        "name": "--space-2xl",
        "$type": "dimension",
        "value": "48px",
