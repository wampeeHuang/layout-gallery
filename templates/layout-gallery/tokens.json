          0,
          0.2,
          1
        ],
        "role": "easing"
      },
      {
        "name": "--duration-fast",
        "$type": "duration",
        "value": "140ms",
        "role": "duration-fast"
      },
      {
        "name": "--duration-base",
        "$type": "duration",
        "value": "200ms",
        "role": "duration-base"
      },
      {
        "name": "--duration-slow",
        "$type": "duration",
        "value": "350ms",
        "role": "duration-slow"
      }
    ],
    "shadow": [
