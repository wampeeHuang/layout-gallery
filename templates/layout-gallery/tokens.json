  "textures": [
    {
      "name": "渐变点阵",
      "cssClass": "tx-dots-fade",
      "technique": "radial-gradient(circle, --text-muted 0.8px, transparent) / 14px + linear-gradient 边缘融解",
      "usage": "数据卡片底纹、hover 高亮区"
    },
    {
      "name": "渐变斜纹",
      "cssClass": "tx-diagonal-fade",
      "technique": "repeating-linear-gradient(-37deg) + linear-gradient 上下边缘淡出",
      "usage": "区段分隔、动效轨道背景"
    },
    {
      "name": "渐变网格",
      "cssClass": "tx-grid-fade",
      "technique": "8×4 CSS Grid gap 1px + parent gradient 代替 solid border",
      "usage": "卡片列表、色板、logo 展示"
    },
    {
      "name": "渐变横线",
      "cssClass": "tx-hlines-fade",
      "technique": "repeating-linear-gradient(0deg) 间距 7px 线宽 1px + 边缘融解",
      "usage": "表格行背景、长列表分隔"
    },
    {
      "name": "渐变竖线",
      "cssClass": "tx-vlines-fade",
      "technique": "repeating-linear-gradient(90deg) 间距 16px 线宽 1px + 边缘融解",
      "usage": "代码块侧栏、时间线背景"
    },
    {
      "name": "渐变噪点",
      "cssClass": "tx-noise-fade",
      "technique": "SVG feTurbulence + 渐变背景 opacity 0.12 叠加",
      "usage": "卡片覆盖层、图片遮罩"
    }
  ],
