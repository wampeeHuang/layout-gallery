{
  "template": "layout-gallery",
  "version": 1,
  "description": "Canonical control plane for the Layout Gallery preview; consumed by template.html and brand projection.",
  "tokens": {
    "color": [
      {
        "name": "--color-primary",
        "$type": "color",
        "value": "#3D6B4A",
        "role": "accent"
      },
      {
        "name": "--color-secondary",
        "$type": "color",
        "value": "#71717A",
        "role": "accent-alt"
      },
      {
        "name": "--color-primary-container",
        "$type": "color",
        "value": "#EEF4EF",
        "role": "accent-subtle"
      },
      {
        "name": "--color-surface",
        "$type": "color",
        "value": "#FFFFFF",
        "role": "surface-bg"
      },
      {
        "name": "--color-surface-container-low",
        "$type": "color",
        "value": "#F4F4F5",
        "role": "surface-card"
      },
      {
        "name": "--color-surface-container-high",
        "$type": "color",
        "value": "#E4E4E7",
        "role": "surface-alt"
      },
      {
        "name": "--color-on-surface",
        "$type": "color",
        "value": "#18181B",
        "role": "text-primary"
      },
      {
        "name": "--color-on-surface-variant",
        "$type": "color",
        "value": "#52525B",
        "role": "text-secondary"
      },
      {
        "name": "--color-outline",
        "$type": "color",
        "value": "#D4D4D8",
        "role": "border-default"
      },
      {
        "name": "--color-outline-variant",
        "$type": "color",
        "value": "#E8E8EC",
        "role": "border-subtle"
      },
      {
        "name": "--color-success",
        "$type": "color",
        "value": "#059669",
        "role": "semantic-success"
      },
      {
        "name": "--color-error",
        "$type": "color",
        "value": "#dc2626",
        "role": "semantic-danger"
      },
      {
        "name": "--heading",
        "$type": "color",
        "value": "#18181B",
        "role": "text-heading"
      }
    ],
    "typography": [
      {
        "name": "--font-display",
        "$type": "fontFamily",
        "value": "\"Noto Serif SC\",\"Source Han Serif SC\",\"Songti SC\",\"SimSun\",serif",
        "role": "display-font"
      },
      {
        "name": "--font-body",
        "$type": "fontFamily",
        "value": "\"Noto Sans SC\",\"Inter\",\"Segoe UI\",\"Helvetica Neue\",\"PingFang SC\",\"Microsoft YaHei UI\",system-ui,sans-serif",
        "role": "body-font"
      },
      {
        "name": "--font-mono",
        "$type": "fontFamily",
        "value": "\"SF Mono\",\"Consolas\",\"Cascadia Code\",\"IBM Plex Mono\",ui-monospace,monospace",
        "role": "mono-font"
      },
      {
        "name": "--typescale-title-medium",
        "$type": "dimension",
        "value": "20px",
        "role": "card-title-size"
      },
      {
        "name": "--typescale-label-large",
        "$type": "dimension",
        "value": "13px",
        "role": "small-size"
      },
      {
        "name": "--typescale-display-large",
        "$type": "dimension",
        "value": "clamp(56px,7vw,104px)",
        "role": "首屏标题"
      },
      {
        "name": "--typescale-headline-large",
        "$type": "dimension",
        "value": "48px",
        "role": "区段标题 (h2)"
      },
      {
        "name": "--typescale-title-large",
        "$type": "dimension",
        "value": "28px",
        "role": "卡片标题"
      },
      {
        "name": "--typescale-body-large",
        "$type": "dimension",
        "value": "17px",
        "role": "正文大"
      },
      {
        "name": "--typescale-body-medium",
        "$type": "dimension",
        "value": "15px",
        "role": "正文"
      },
      {
        "name": "--typescale-label-medium",
        "$type": "dimension",
        "value": "11px",
        "role": "标签/眉题"
      }
    ],
    "motion": [
      {
        "name": "--ease-standard",
        "$type": "cubicBezier",
        "value": [
          0.4,
          0,
          0.2,
          1
        ],
        "role": "easing"
      },
      {
        "name": "--duration-fast",
        "$type": "duration",
        "value": "140ms",
        "role": "duration-fast"
      },
      {
        "name": "--duration-base",
        "$type": "duration",
        "value": "200ms",
        "role": "duration-base"
      },
      {
        "name": "--duration-slow",
        "$type": "duration",
        "value": "350ms",
        "role": "duration-slow"
      }
    ],
    "shadow": [
      {
        "name": "--elevation-sm",
        "$type": "shadow",
        "value": "0 2px 8px rgba(0,0,0,0.06)",
        "role": "shadow-subtle"
      },
      {
        "name": "--elevation-md",
        "$type": "shadow",
        "value": "0 8px 24px rgba(0,0,0,0.08)",
        "role": "shadow-card"
      }
    ],
    "radius": [
      {
        "name": "--radius-none",
        "$type": "dimension",
        "value": "0px",
        "role": "radius-card"
      },
      {
        "name": "--radius-xs",
        "$type": "dimension",
        "value": "4px",
        "role": "radius-subtle"
      },
      {
        "name": "--radius-pill",
        "$type": "dimension",
        "value": "999px",
        "role": "radius-pill"
      }
    ],
    "spacing": [
      {
        "name": "--space-page-wmax",
        "$type": "dimension",
        "value": "1920px",
        "role": "content-max-width"
      },
      {
        "name": "--space-page-pad",
        "$type": "dimension",
        "value": "48px",
        "role": "page-padding"
      },
      {
        "name": "--space-gap",
        "$type": "dimension",
        "value": "16px",
        "role": "element-gap"
      },
      {
        "name": "--space-gutter",
        "$type": "dimension",
        "value": "24px",
        "role": "column-gutter"
      },
      {
        "name": "--space-64",
        "$type": "dimension",
        "value": "64px",
        "role": "section-gap"
      },
      {
        "name": "--space-32",
        "$type": "dimension",
        "value": "32px",
        "role": "component-gap"
      },
      {
        "name": "--space-16",
        "$type": "dimension",
        "value": "16px",
        "role": "tight-gap"
      },
      {
        "name": "--space-8",
        "$type": "dimension",
        "value": "8px",
        "role": "micro-gap"
      },
      {
        "name": "--space-48",
        "$type": "dimension",
        "value": "48px",
        "role": "large-section-gap"
      },
      {
        "name": "--space-24",
        "$type": "dimension",
        "value": "24px",
        "role": "card-padding"
      },
      {
        "name": "--space-12",
        "$type": "dimension",
        "value": "12px",
        "role": "small-gap"
      },
      {
        "name": "--space-4",
        "$type": "dimension",
        "value": "4px",
        "role": "micro-padding"
      },
      {
        "name": "--hairline",
        "$type": "dimension",
        "value": "1px",
        "role": "hairline-stroke"
      }
    ],
    "other": [
      {
        "name": "--transform-0",
        "$type": "raw",
        "value": "translateY(-160%)",
        "role": "migrated"
      },
      {
        "name": "--transform-1",
        "$type": "raw",
        "value": "translateY(0)",
        "role": "migrated"
      },
      {
        "name": "--transform-2",
        "$type": "raw",
        "value": "translateY(-.12rem)",
        "role": "migrated"
      },
      {
        "name": "--bg-0",
        "$type": "raw",
        "value": "linear-gradient(to right, var(--color-outline-variant) var(--hairline), transparent var(--hairline)), linear-gradient(to bottom, var(--color-outline-variant) var(--hairline), transparent var(--hairline))",
        "role": "migrated"
      }
    ]
  }
}
