        "name": "--elevation-sm",
        "$type": "shadow",
        "value": "0 2px 8px rgba(0,0,0,0.06)",
        "role": "shadow-subtle"
      },
      {
        "name": "--elevation-md",
        "$type": "shadow",
        "value": "0 8px 24px rgba(0,0,0,0.08)",
