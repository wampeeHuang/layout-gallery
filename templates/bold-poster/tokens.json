{
  "template": "bold-poster",
  "version": 1,
  "description": "Auto-generated from brand.json + layout.json. Review before publishing.",
  "tokens": {
    "color": [
      {
        "name": "--bg",
        "$type": "color",
        "value": "#FFFFFF",
        "role": "surface-bg"
      },
      {
        "name": "--dark",
        "$type": "color",
        "value": "#1C1410",
        "role": "text-primary"
      },
      {
        "name": "--light",
        "$type": "color",
        "value": "#F5F2EF",
        "role": "surface-bg"
      },
      {
        "name": "--color-primary",
        "$type": "color",
        "value": "#D8000F",
        "role": "accent"
      },
      {
        "name": "--color-secondary",
        "$type": "color",
        "value": "#666666",
        "role": "accent-alt"
      },
      {
        "name": "--color-surface",
        "$type": "color",
        "value": "#FFFFFF",
        "role": "surface-bg"
      },
      {
        "name": "--color-on-surface",
        "$type": "color",
        "value": "#1C1410",
        "role": "text-primary"
      },
      {
        "name": "--color-on-surface-variant",
        "$type": "color",
        "value": "#666666",
        "role": "text-secondary"
      },
      {
        "name": "--color-outline",
        "$type": "color",
        "value": "rgba(10,10,10,0.15)",
        "role": "border-default"
      },
      {
        "name": "--color-surface-container-low",
        "$type": "color",
        "value": "#FFFFFF",
        "role": "surface-card"
      },
      {
        "name": "--red",
        "$type": "color",
        "value": "#D8000F",
        "role": "color-palette"
      }
    ],
    "typography": [
      {
        "name": "--font-display",
        "$type": "fontFamily",
        "value": "'Shrikhand', cursive",
        "role": "display-font"
      },
      {
        "name": "--font-body",
        "$type": "fontFamily",
        "value": "'Libre Baskerville', serif",
        "role": "body-font"
      },
      {
        "name": "--font-mono",
        "$type": "fontFamily",
        "value": "'Space Grotesk', sans-serif",
        "role": "mono-font"
      },
      {
        "name": "--typescale-body-large",
        "$type": "dimension",
        "value": "16px",
        "role": "默认正文字号"
      }
    ],
    "radius": [
      {
        "name": "--radius-xs",
        "$type": "dimension",
        "value": "4px",
        "role": "radius"
      },
      {
        "name": "--radius-pill",
        "$type": "dimension",
        "value": "999px",
        "role": "radius"
      }
    ],
    "shadow": [
      {
        "name": "--elevation-sm",
        "$type": "shadow",
        "value": "0 1px 3px rgba(0,0,0,0.06)",
        "role": "shadow"
      },
      {
        "name": "--elevation-md",
        "$type": "shadow",
        "value": "0 8px 30px rgba(0,0,0,0.1)",
        "role": "shadow"
      }
    ],
    "motion": [
      {
        "name": "--ease-standard",
        "$type": "raw",
        "value": "0.18s ease",
        "role": "easing"
      },
      {
        "name": "--duration-base",
        "$type": "duration",
        "value": "150ms",
        "role": "duration"
      }
    ],
    "spacing": [
      {
        "name": "--space-page-wmax",
        "$type": "dimension",
        "value": "1200px",
        "role": "content-max-width"
      },
      {
        "name": "--space-page-pad",
        "$type": "dimension",
        "value": "32px",
        "role": "page-padding"
      },
      {
        "name": "--space-gap",
        "$type": "dimension",
        "value": "24px",
        "role": "element-gap"
      },
      {
        "name": "--space-gutter",
        "$type": "dimension",
        "value": "24px",
        "role": "column-gutter"
      }
    ]
  }
}
