{
  "$schema": "https://tr.designtokens.org/format/2025-10/",
  "version": "4.0.0",
  "description": "版式画廊 Token 命名合约 — 基于 Material Design 3 颜色角色体系（29 角色），W3C DTCG 格式。所有模板 tokens.json 的 name 字段必须使用本标准名。",
  "source": "https://m3.material.io/styles/color/roles",
  "knowledgeBase": "D:\\Obsidian\\Raw\\web-design\\md3-color-roles.md",

  "naming": {
    "convention": "CSS 自定义属性 kebab-case",
    "prefix": "--color-",
    "pattern": "--color-{group}-{variant}",
    "example": "--color-primary, --color-on-primary, --color-primary-container"
  },

  "standardVars": {
    "_convention": "required=true 的每个模板必须声明。required=false 的按需使用。",

    "color": {
      "primary": {
        "--color-primary":                    {"md3": "primary",              "role": "主强调色 — 按钮、活跃态、FAB",                           "required": true},
        "--color-on-primary":                {"md3": "on-primary",           "role": "primary 上的文字/图标",                                 "required": false},
        "--color-primary-container":         {"md3": "primary-container",    "role": "primary 浅色容器背景",                                  "required": false},
        "--color-on-primary-container":      {"md3": "on-primary-container", "role": "primary-container 上的文字",                             "required": false}
      },
      "secondary": {
        "--color-secondary":                 {"md3": "secondary",              "role": "辅强调色 — 筛选标签、次要按钮",                          "required": true},
        "--color-on-secondary":              {"md3": "on-secondary",           "role": "secondary 上的文字/图标",                               "required": false},
        "--color-secondary-container":       {"md3": "secondary-container",    "role": "secondary 浅色容器背景",                                "required": false},
        "--color-on-secondary-container":    {"md3": "on-secondary-container", "role": "secondary-container 上的文字",                           "required": false}
      },
      "tertiary": {
        "--color-tertiary":                  {"md3": "tertiary",              "role": "第三强调色 — 对比平衡 primary/secondary",                "required": false},
        "--color-on-tertiary":               {"md3": "on-tertiary",           "role": "tertiary 上的文字/图标",                                "required": false},
        "--color-tertiary-container":        {"md3": "tertiary-container",    "role": "tertiary 浅色容器背景",                                "required": false},
        "--color-on-tertiary-container":     {"md3": "on-tertiary-container", "role": "tertiary-container 上的文字",                           "required": false}
      },
      "error": {
        "--color-error":                     {"md3": "error",              "role": "错误色 — 错误提示、删除按钮",                             "required": false},
        "--color-on-error":                  {"md3": "on-error",           "role": "error 上的文字/图标",                                   "required": false},
        "--color-error-container":           {"md3": "error-container",    "role": "error 浅色容器背景",                                    "required": false},
        "--color-on-error-container":        {"md3": "on-error-container", "role": "error-container 上的文字",                               "required": false}
      },
      "surface": {
        "--color-surface":                   {"md3": "surface",                   "role": "页面默认背景 — body 底色",                         "required": true},
        "--color-on-surface":                {"md3": "on-surface",                "role": "surface 上的主文字 — 正文色",                       "required": true},
        "--color-on-surface-variant":        {"md3": "on-surface-variant",        "role": "surface 上的次级文字 — 说明、标签",                  "required": true},
        "--color-surface-dim":               {"md3": "surface-dim",               "role": "暗色模式表面",                                      "required": false},
        "--color-surface-bright":            {"md3": "surface-bright",            "role": "亮色模式表面",                                      "required": false},
        "--color-surface-container-lowest":  {"md3": "surface-container-lowest",  "role": "最低强调容器",                                      "required": false},
        "--color-surface-container-low":     {"md3": "surface-container-low",     "role": "低强调容器 — 卡片默认背景",                          "required": false},
        "--color-surface-container":         {"md3": "surface-container",         "role": "默认容器 — 面板背景",                               "required": false},
        "--color-surface-container-high":    {"md3": "surface-container-high",    "role": "高强调容器 — 弹出层",                               "required": false},
        "--color-surface-container-highest": {"md3": "surface-container-highest", "role": "最高强调容器 — 对话框",                              "required": false}
      },
      "outline": {
        "--color-outline":                   {"md3": "outline",         "role": "主边框 — 输入框边框、分割线",                             "required": true},
        "--color-outline-variant":           {"md3": "outline-variant", "role": "次级边框 — 装饰线、轻分割",                               "required": false}
      },
      "extended": {
        "--color-success":                   {"md3": "—", "role": "成功反馈色 — 确认、已复制",                                   "required": false},
        "--color-background":                {"md3": "background (legacy)", "role": "body 级硬底色 — 幻灯片容器/深色外框",             "required": false},
        "--color-shadow":                    {"md3": "shadow",           "role": "阴影色 — elevation shadow",                        "required": false}
      }
    },

    "typography": {
      "--font-display":  {"role": "标题字体栈 — 展示/封面用",       "required": true},
      "--font-body":     {"role": "正文字体栈 — 段落/UI 用",        "required": true},
      "--font-mono":     {"role": "等宽字体栈 — 代码/标签/KPI 用",  "required": false}
    },

    "spacing": {
      "--space-page-wmax":  {"role": "内容最大宽度",      "required": true},
      "--space-page-pad":   {"role": "页面水平内边距",     "required": true},
      "--space-gap":        {"role": "元素/网格基准间距",  "required": true},
      "--space-gutter":     {"role": "列间距/留白基准",    "required": true}
    },

    "radius": {
      "--radius-base":  {"role": "圆角基准值",  "required": true}
    },

    "shadow": {
      "--elevation-sm": {"role": "轻阴影 — 卡片默认",  "required": true},
      "--elevation-md": {"role": "中阴影 — 卡片悬浮",  "required": false}
    },

    "motion": {
      "--ease-standard":    {"role": "标准缓动曲线",  "required": true},
      "--duration-base":    {"role": "基础过渡时长",  "required": true}
    }
  },

  "templateSpecific": {
    "_convention": "以下 token 不属于标准合约，是模板特有的渲染技法或领域词汇。不在 standardVars 检查范围内。",
    "8-bit-orbit": {
      "rendering": ["--win-highlight", "--win-shadow", "--win-dark-shadow", "--win-bg", "--win-face"],
      "chrome": ["--win-blue", "--win-blue-bright", "--deep-navy"],
      "palette": ["--neon-yellow", "--soft-lavender", "--neon-cyan", "--neon-pink", "--dark-void"],
      "spacing": ["--pixel-size"],
      "note": "Win95 3D bevel 是浮雕渲染技法。chrome accent 是与 --color-primary 并存的第二强调体系。"
    },
    "soft-editorial": {
      "palette": ["--blush", "--sage", "--lilac", "--paper-2", "--pink", "--lemon", "--paper", "--ink"],
      "color": ["--ink-soft"],
      "spacing": ["--page-w", "--page-margin"],
      "radius": ["--radius-sm", "--radius-pill", "--radius-lg", "--radius-md", "--radius-xs", "--radius-14", "--radius-16", "--radius-18", "--radius-22"],
      "shadow": ["--shadow-card"],
      "note": "MD3 container 体系覆盖：blush→tertiary, sage→secondary-container, lilac→tertiary-container。半径命名空间扩展为视觉探索需要。"
    },
    "template-swiss": {
      "palette": ["--grey-1", "--grey-2", "--grey-3", "--border-strong", "--border-subtle"],
      "color": ["--paper", "--ink", "--text-primary", "--text-secondary", "--text-helper", "--text-placeholder", "--text-on-color"],
      "spacing": ["--sp-3", "--sp-4", "--sp-5", "--sp-6", "--sp-7", "--sp-8", "--sp-9", "--sp-10", "--sp-11", "--sp-12", "--sp-13", "--nav-safe-bottom"],
      "motion": ["--ease-prod", "--ease-exp", "--ease-entry-prod", "--ease-entry-exp", "--ease-page", "--ease-draw", "--dur-fast-1", "--dur-fast-2", "--dur-mod-1", "--dur-mod-2", "--dur-slow-1", "--dur-slow-2", "--dur-page", "--dur-draw"],
      "note": "Swiss 排版体系命名自成一体。paper/ink 语义 + 模块化 duration 量表。不映射到 MD3。"
    },
    "template": {
      "palette": ["--paper-tint", "--paper", "--ink"],
      "color": ["--ink-tint"],
      "spacing": ["--page-w"],
      "radius": ["--radius-sm", "--radius-pill"],
      "motion": ["--dur-page", "--dur-slow-1", "--dur-mod-2", "--dur-fast-1", "--dur-slow-2", "--ease-page", "--ease-draw"],
      "note": "paper-tint → surface-container-low 覆盖。duration 量表为动画探索。"
    },
    "brutalist-paper": {
      "spacing": ["--page-w"],
      "shadow": ["--shadow", "--shadow-solid", "--shadow-block"],
      "motion": ["--ease-hover"],
      "note": "brutalist 粗野主义阴影系统：硬阴影、块状阴影是视觉语言核心。"
    },
    "layout-gallery": {
      "color": ["--heading"],
      "typography": ["--text-3xl", "--text-2xl", "--text-xl", "--text-base", "--text-sm", "--text-xs"],
      "spacing": ["--space-3xl", "--space-2xl", "--space-xl", "--space-lg", "--space-md", "--space-sm", "--space-xs", "--space-2xs", "--hairline"],
      "radius": ["--radius-sm", "--radius-pill"],
      "motion": ["--duration-fast", "--duration-slow"],
      "note": "Gallery UI 自身的字号量表 + 间距量表。与 MD3 template tokens 是不同层级。"
    }
  },

  "brandKit": {
    "_convention": "brandKit.colorRoles 将标准颜色角色映射到 CSS 变量。所有模板必须包含这 7 个 key。",
    "colorRoles": {
      "primary":       "--color-primary",
      "secondary":     "--color-secondary",
      "background":    "--color-surface",
      "text":          "--color-on-surface",
      "textSecondary": "--color-on-surface-variant",
      "border":        "--color-outline",
      "surface":       "--color-surface-container-low"
    }
  },

  "compliance": {
    "full": "所有 token name 来自本标准词汇表 + colorRoles 7 键完整",
    "migration": "token name 在 migrationMap 中 → 需迁移到新名",
    "violation": "token name 不在标准词汇表、不在 migrationMap、不在 templateSpecific → 报错"
  }
}
