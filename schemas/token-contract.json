{
  "$schema": "https://tr.designtokens.org/format/2025-10/",
  "version": "5.0.0",
  "description": "版式画廊 Token 命名合约 — 基于 Material Design 3 颜色角色体系。v5: brand/layout 分层，品牌套件跨站点可复用，布局令牌站点自治。",
  "source": "https://m3.material.io/styles/color/roles",
  "layers": {
    "brand": "设计语言层 — 颜色角色 + 字体家族 + 动效 + 阴影 + 圆角。跨站点可复用，迁移时逐值对齐上游 :root。",
    "layout": "页面配置层 — 字号刻度 + 间距刻度 + 页面宽度。每个站点自己定义，迁移时不强制对齐。"
  },
  "standardVars": {
    "_convention": "每个变量有 type(品牌/布局) + level(required/optional)。required 的每个模板必须声明。",
    "brand": {
      "_description": "品牌套件 — 定义视觉语言，跨站点一致。",
      "color": {
        "--color-primary": {
          "type": "brand",
          "md3": "primary",
          "role": "主强调色",
          "required": true
        },
        "--color-on-primary": {
          "type": "brand",
          "md3": "on-primary",
          "role": "primary 上的文字/图标",
          "required": false
        },
        "--color-primary-container": {
          "type": "brand",
          "md3": "primary-container",
          "role": "primary 浅色容器背景",
          "required": false
        },
        "--color-on-primary-container": {
          "type": "brand",
          "md3": "on-primary-container",
          "role": "primary-container 上的文字",
          "required": false
        },
        "--color-secondary": {
          "type": "brand",
          "md3": "secondary",
          "role": "辅强调色",
          "required": true
        },
        "--color-on-secondary": {
          "type": "brand",
          "md3": "on-secondary",
          "role": "secondary 上的文字/图标",
          "required": false
        },
        "--color-secondary-container": {
          "type": "brand",
          "md3": "secondary-container",
          "role": "secondary 浅色容器背景",
          "required": false
        },
        "--color-on-secondary-container": {
          "type": "brand",
          "md3": "on-secondary-container",
          "role": "secondary-container 上的文字",
          "required": false
        },
        "--color-tertiary": {
          "type": "brand",
          "md3": "tertiary",
          "role": "第三强调色",
          "required": false
        },
        "--color-on-tertiary": {
          "type": "brand",
          "md3": "on-tertiary",
          "role": "tertiary 上的文字/图标",
          "required": false
        },
        "--color-tertiary-container": {
          "type": "brand",
          "md3": "tertiary-container",
          "role": "tertiary 浅色容器背景",
          "required": false
        },
        "--color-on-tertiary-container": {
          "type": "brand",
          "md3": "on-tertiary-container",
          "role": "tertiary-container 上的文字",
          "required": false
        },
        "--color-error": {
          "type": "brand",
          "md3": "error",
          "role": "错误色",
          "required": false
        },
        "--color-on-error": {
          "type": "brand",
          "md3": "on-error",
          "role": "error 上的文字/图标",
          "required": false
        },
        "--color-error-container": {
          "type": "brand",
          "md3": "error-container",
          "role": "error 浅色容器背景",
          "required": false
        },
        "--color-on-error-container": {
          "type": "brand",
          "md3": "on-error-container",
          "role": "error-container 上的文字",
          "required": false
        },
        "--color-surface": {
          "type": "brand",
          "md3": "surface",
          "role": "页面默认背景",
          "required": true
        },
        "--color-on-surface": {
          "type": "brand",
          "md3": "on-surface",
          "role": "主文字色",
          "required": true
        },
        "--color-on-surface-variant": {
          "type": "brand",
          "md3": "on-surface-variant",
          "role": "次级文字色",
          "required": true
        },
        "--color-surface-dim": {
          "type": "brand",
          "md3": "surface-dim",
          "role": "暗色模式表面",
          "required": false
        },
        "--color-surface-bright": {
          "type": "brand",
          "md3": "surface-bright",
          "role": "亮色模式表面",
          "required": false
        },
        "--color-surface-container-lowest": {
          "type": "brand",
          "md3": "surface-container-lowest",
          "role": "最低强调容器",
          "required": false
        },
        "--color-surface-container-low": {
          "type": "brand",
          "md3": "surface-container-low",
          "role": "低强调容器 — 卡片默认背景",
          "required": false
        },
        "--color-surface-container": {
          "type": "brand",
          "md3": "surface-container",
          "role": "默认容器",
          "required": false
        },
        "--color-surface-container-high": {
          "type": "brand",
          "md3": "surface-container-high",
          "role": "高强调容器",
          "required": false
        },
        "--color-surface-container-highest": {
          "type": "brand",
          "md3": "surface-container-highest",
          "role": "最高强调容器",
          "required": false
        },
        "--color-outline": {
          "type": "brand",
          "md3": "outline",
          "role": "主边框/分割线",
          "required": true
        },
        "--color-outline-variant": {
          "type": "brand",
          "md3": "outline-variant",
          "role": "次级边框",
          "required": false
        },
        "--color-success": {
          "type": "brand",
          "md3": "—",
          "role": "成功反馈色",
          "required": false
        },
        "--color-background": {
          "type": "brand",
          "md3": "background (legacy)",
          "role": "body 硬底色",
          "required": false
        },
        "--color-shadow": {
          "type": "brand",
          "md3": "shadow",
          "role": "阴影色",
          "required": false
        },
        "--heading": {
          "type": "brand",
          "md3": "—",
          "role": "标题专用色",
          "required": false
        }
      },
      "typography": {
        "_description": "字体家族 — 只有字体栈，不含字号。字号属于 layout。",
        "--font-display": {
          "type": "brand",
          "role": "标题字体栈",
          "required": true
        },
        "--font-body": {
          "type": "brand",
          "role": "正文字体栈",
          "required": true
        },
        "--font-mono": {
          "type": "brand",
          "role": "等宽字体栈",
          "required": false
        }
      },
      "radius": {
        "--radius-base": {
          "type": "brand",
          "role": "圆角基准",
          "required": true
        },
        "--radius-sm": {
          "type": "brand",
          "role": "小圆角 — 按钮/代码块",
          "required": false
        },
        "--radius-pill": {
          "type": "brand",
          "role": "胶囊圆角 — 标签/眉题",
          "required": false
        }
      },
      "shadow": {
        "--elevation-sm": {
          "type": "brand",
          "role": "轻阴影 — 卡片默认",
          "required": true
        },
        "--elevation-md": {
          "type": "brand",
          "role": "中阴影 — 卡片悬浮",
          "required": false
        }
      },
      "motion": {
        "--ease-standard": {
          "type": "brand",
          "role": "标准缓动曲线",
          "required": true
        },
        "--duration-base": {
          "type": "brand",
          "role": "基础过渡时长",
          "required": true
        },
        "--duration-fast": {
          "type": "brand",
          "role": "快速过渡",
          "required": false
        },
        "--duration-slow": {
          "type": "brand",
          "role": "慢速过渡",
          "required": false
        }
      }
    },
    "layout": {
      "_description": "布局配置 — 页面宽度 + 字号刻度 + 间距刻度。站点自主定义。",
      "typography": {
        "_description": "字号刻度 — 从品牌字体家族派生具体尺寸。",
        "--text-3xl": {
          "type": "layout",
          "role": "区段标题",
          "required": false
        },
        "--text-2xl": {
          "type": "layout",
          "role": "卡片标题",
          "required": false
        },
        "--text-xl": {
          "type": "layout",
          "role": "正文大",
          "required": false
        },
        "--text-base": {
          "type": "layout",
          "role": "正文",
          "required": false
        },
        "--text-sm": {
          "type": "layout",
          "role": "辅助文字",
          "required": false
        },
        "--text-xs": {
          "type": "layout",
          "role": "标签/眉题",
          "required": false
        }
      },
      "spacing": {
        "--space-page-wmax": {
          "type": "layout",
          "role": "内容最大宽度",
          "required": true
        },
        "--space-page-pad": {
          "type": "layout",
          "role": "页面水平内边距",
          "required": true
        },
        "--space-gap": {
          "type": "layout",
          "role": "元素/网格基准间距",
          "required": true
        },
        "--space-gutter": {
          "type": "layout",
          "role": "列间距/留白基准",
          "required": true
        },
        "--space-3xl": {
          "type": "layout",
          "role": "区段间距",
          "required": false
        },
        "--space-2xl": {
          "type": "layout",
          "role": "大区段间距",
          "required": false
        },
        "--space-xl": {
          "type": "layout",
          "role": "组件间距",
          "required": false
        },
        "--space-lg": {
          "type": "layout",
          "role": "卡片内边距",
          "required": false
        },
        "--space-md": {
          "type": "layout",
          "role": "副标题间距",
          "required": false
        },
        "--space-sm": {
          "type": "layout",
          "role": "小间距",
          "required": false
        },
        "--space-xs": {
          "type": "layout",
          "role": "标签内边距",
          "required": false
        },
        "--space-2xs": {
          "type": "layout",
          "role": "微内边距",
          "required": false
        },
        "--hairline": {
          "type": "layout",
          "role": "极细线宽",
          "required": false
        }
      }
    }
  },
  "templateSpecific": {
