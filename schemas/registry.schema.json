{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layouts.blackcamellia.xin/registry.schema.json",
  "title": "版式画廊 · 模板注册表 Schema",
  "description": "每个模板条目的完整字段定义。AI Agent 和人类共享同一份合约。身份分类（visual_family/content_type/tone）直接在此处，枚举见 data/taxonomy.json。",
  "type": "object",
  "required": ["slug", "name", "skill", "scheme", "visibility", "template_path"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "URL 友好标识符，kebab-case，全局唯一"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "模板显示名称，中文优先"
    },
    "tagline": {
      "type": "string",
      "description": "一句话卖点。AI 搜索匹配此字段"
    },
    "skill": {
      "type": "string",
      "enum": ["beautiful-html-templates", "guizang-ppt-skill", "frontend-design", "codebase-to-course", "design-systems"],
      "description": "模板来源 skill"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": ["16:9", "9:16", "auto"],
      "default": "16:9"
    },
    "visual_family": {
      "type": "string",
      "enum": ["editorial", "swiss", "brutalist", "retro", "organic", "graphic"],
      "description": "视觉风格家族 — 模板长什么样"
    },
    "content_type": {
      "type": "string",
      "enum": ["landing", "portfolio", "blog", "corporate", "dashboard", "ecommerce", "personal"],
      "description": "页面用途分类 — 模板适合做什么"
    },
    "tone": {
      "type": "array",
      "items": { "type": "string", "enum": ["dramatic", "playful", "warm", "confident", "sober", "friendly", "upbeat", "punchy"] },
      "description": "情绪调性标签，非互斥"
    },
    "formality": {
      "type": "string",
      "enum": ["low", "medium-low", "medium", "medium-high", "high"],
      "default": "medium",
      "description": "正式度: low=休闲, medium-low=半正式, medium=适中, medium-high=正式, high=权威"
    },
    "density": {
      "type": "string",
      "enum": ["low", "medium", "medium-high", "high"],
      "default": "medium",
      "description": "信息密度: low=留白多, medium=均衡, medium-high=较密, high=高密度"
    },
    "scheme": {
      "type": "string",
      "enum": ["light", "dark", "mixed"],
      "description": "配色方案: light=亮色, dark=暗色, mixed=混合"
    },
    "best_for": {
      "type": "array",
      "items": { "type": "string" },
      "description": "最适合的使用场景"
    },
    "avoid_for": {
      "type": "array",
      "items": { "type": "string" },
      "description": "不适合的使用场景"
    },
    "features": {
      "type": "array",
      "items": { "type": "string" },
      "description": "能力标记: chart=图表, code=代码, table=表格, citation=引用, stat=统计数字, 也可自由描述"
    },
    "slide_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "local"],
      "default": "public",
      "description": "public=线上可见, local=仅本地"
    },
    "status": {
      "type": "string",
      "enum": ["active", "placeholder"],
      "default": "active"
    },
    "preview_type": {
      "type": "string",
      "enum": ["iframe"],
      "default": "iframe"
    },
    "template_path": {
      "type": "string",
      "pattern": "^templates/[a-z0-9-]+/[a-z0-9-]+/template\\.html$",
      "description": "模板 HTML 文件路径，相对于项目根目录"
    }
  }
}
